# OpenAI-compatible LLM provider settings
LLM_BASE_URL=http://127.0.0.1:31415/v1
LLM_API_KEY=your-key-here
LLM_MODEL=claude-haiku-4-5

# Network and local HTTP / HTTPS server
HOST=0.0.0.0
PORT=8000
HTTPS_PORT=8443
CERT_FILE=certs/cert.pem
KEY_FILE=certs/key.pem

# Cognitive memory in SQLite
MAX_SHORT_TERM_MESSAGES=10
MAX_USER_FACTS=25
DB_PATH=data/memory.db

# Local voice (Whisper STT and macOS TTS)
STT_MODEL=base
STT_LANGUAGE=pt
TTS_VOICE=Luciana

# Default weather (Open-Meteo, no API key needed)
WEATHER_CITY=São Paulo
WEATHER_LATITUDE=-23.5505
WEATHER_LONGITUDE=-46.6333

# Network access (RG406H/iPhone over Wi-Fi). From the Mac (localhost) a token is never asked for.
# Without DESK_ACCESS_TOKEN, the server generates a new token on every start and prints it in the terminal.
DESK_ACCESS_TOKEN=
# Development only: 1 turns the token off, and any device on the network can use /api and /ws.
DESK_DEV_NO_TOKEN=0
