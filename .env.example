# Configuração do provedor LLM compatível com OpenAI
LLM_BASE_URL=http://127.0.0.1:31415/v1
LLM_API_KEY=sua-chave-aqui
LLM_MODEL=claude-haiku-4-5

# Rede e servidor HTTP / HTTPS local
HOST=0.0.0.0
PORT=8000
HTTPS_PORT=8443
CERT_FILE=certs/cert.pem
KEY_FILE=certs/key.pem

# Memória cognitiva em SQLite
MAX_SHORT_TERM_MESSAGES=10
MAX_USER_FACTS=25
DB_PATH=data/memory.db

# Voz local (STT Whisper e TTS macOS)
STT_MODEL=base
STT_LANGUAGE=pt
TTS_VOICE=Luciana

# Clima padrão (Open-Meteo, sem necessidade de API key)
WEATHER_CITY=São Paulo
WEATHER_LATITUDE=-23.5505
WEATHER_LONGITUDE=-46.6333

# Acesso pela rede (RG406H/iPhone via Wi-Fi). Pelo Mac (localhost) nunca pede token.
# Sem DESK_ACCESS_TOKEN, o servidor gera um token novo a cada início e mostra no terminal.
DESK_ACCESS_TOKEN=
# Só em desenvolvimento: 1 desliga o token, e qualquer aparelho da rede usa /api e /ws.
DESK_DEV_SEM_TOKEN=0
